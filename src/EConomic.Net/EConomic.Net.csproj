<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>EConomic.Net</AssemblyName>
    <RootNamespace>EConomic</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <!--
      The package id is owner-prefixed because `EConomic.*` is a reserved id prefix on nuget.org
      owned by someone else, and pushing under it is rejected with a 409. The project, assembly and
      namespaces keep their own names — only the published id is prefixed.
    -->
    <PackageId>Pogoe.EConomic</PackageId>
    <Title>Pogoe.EConomic</Title>
    <Description>Unofficial .NET client for the Visma e-conomic accounting APIs, covering both the legacy REST API and the newer OpenAPI services. Not affiliated with or endorsed by Visma.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Trimming">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Label="Test access">
    <!-- The AOT smoke test drives the generated clients, which are deliberately internal. -->
    <InternalsVisibleTo Include="EConomic.Net.AotSmokeTest" />
    <!-- Paging is tested against a fake page source rather than a network. -->
    <InternalsVisibleTo Include="EConomic.Net.Tests" />
  </ItemGroup>

  <ItemGroup Label="Public API surface lock">
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
