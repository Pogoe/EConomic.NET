root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Usings
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Modern C# style
csharp_style_namespace_declarations = file_scoped:warning
# `var` is the house style throughout, which is what the code already does in ~420 places. The
# preference is recorded here so a re-enabled severity pushes towards `var` rather than away from
# it, and IDE0007/IDE0008 are then turned off outright: at `:suggestion` they are invisible in the
# editor and in `dotnet format`, but SonarQube Cloud imports Roslyn diagnostics regardless of
# severity and filed all 417 as maintainability issues. A rule nobody enforces should not report.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
dotnet_diagnostic.IDE0007.severity = none         # "use var"
dotnet_diagnostic.IDE0008.severity = none         # "use explicit type"
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# `this.` is noise
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# Naming. Order matters: the first rule whose symbol group matches wins, so constants
# must be declared before the private-field rule or they would be asked for an underscore.
dotnet_naming_rule.constants_pascal_case.severity = warning
dotnet_naming_rule.constants_pascal_case.symbols = constant_fields
dotnet_naming_rule.constants_pascal_case.style = pascal_case
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.static_readonly_pascal_case.severity = warning
dotnet_naming_rule.static_readonly_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal_case.style = pascal_case
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# ConfigureAwait(false) is written explicitly on library awaits rather than enforced by analyzer,
# which would also fire across the test projects where it is pointless.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = none          # LoggerMessage source-gen not required everywhere
dotnet_diagnostic.RS0016.severity = error         # public API must be declared in PublicAPI.*.txt
dotnet_diagnostic.RS0017.severity = error

# Public members need XML docs
dotnet_diagnostic.CS1591.severity = error

[src/EConomic.Net/{Open,Rest}/Generated/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.IDE0005.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none          # test method names use underscores
