<Project>

  <!-- Identity: change these two in this file only. Everything else derives from them. -->
  <PropertyGroup>
    <Authors>Christian Winther-Knudsen</Authors>
    <RepositoryUrl>https://github.com/Pogoe/EConomic.NET</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Versioning. MinVer has no default tag prefix, so without this a `v0.1.0` tag is simply not
    matched and the release publishes 0.0.0-alpha.0.<height> instead — a version that cannot be
    taken back, since nuget.org unlists rather than deletes. The release workflow documents `v*`
    tags, so the prefix has to be declared here to agree with it.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!-- Reproducible builds -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Shared package metadata. SourceLink for GitHub ships in the .NET 8+ SDK; no PackageReference needed. -->
  <PropertyGroup>
    <Company>$(Authors)</Company>
    <Copyright>Copyright (c) $(Authors)</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>e-conomic;economic;visma;accounting;erp;api-client;denmark</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!--
      The file itself is packed by the project that produces the package, next to the readme.
      `PackageIcon` names the path *inside* the nupkg, not the path on disk, so declaring it here
      and packing it there is the only combination that works.
    -->
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

</Project>
