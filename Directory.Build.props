<Project>

  <!-- Identity: change these two in this file only. Everything else derives from them. -->
  <PropertyGroup>
    <Authors>Christian Winther-Knudsen</Authors>
    <RepositoryUrl>https://github.com/Pogoe/EConomic.NET</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Reproducible builds -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Shared package metadata. SourceLink for GitHub ships in the .NET 8+ SDK; no PackageReference needed. -->
  <PropertyGroup>
    <Company>$(Authors)</Company>
    <Copyright>Copyright (c) $(Authors)</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>e-conomic;economic;visma;accounting;erp;api-client;denmark</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- TODO: add PackageIcon once an icon.png exists in the repo root. -->
  </PropertyGroup>

</Project>
